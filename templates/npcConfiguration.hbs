<section class="standard-form vurs-npc-configuration-content">
  <p class="hint">Configure level adjustments and Play Resource maximum formulas for {{actorName}}.</p>
  <nav class="tabs" aria-label="NPC configuration sections">
    <button type="button" class="active" data-npc-config-tab="levels" aria-selected="true">Leveled NPC</button>
    <button type="button" data-npc-config-tab="relationships" aria-selected="false">Relationship</button>
    <button type="button" data-npc-config-tab="resources" aria-selected="false">Play Resources</button>
  </nav>
  <section class="npc-config-panel" data-npc-config-panel="levels">
    <div class="npc-config-level-inputs">
      <label class="form-group">
        <span>Adjusted Level</span>
        <input type="number" name="addedLevels" step="1" value="{{addedLevels}}" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
    <p class="hint">Final Level: <span data-final-level>{{finalLevel}}</span></p>
    <details class="npc-config-scaling">
      <summary>Stat Scaling</summary>
      <fieldset>
        <legend>Scaling per NPC level</legend>
      {{#each scalingGroups}}
      <fieldset class="npc-config-scaling-group">
        <legend>{{label}}</legend>
        <div class="npc-config-scaling-grid">
          {{#each fields}}
          <label class="npc-config-scaling-field {{#if toggleOnly}}npc-config-scaling-toggle{{/if}}">
            <input type="checkbox" name="scalingEnabled.{{key}}" data-default-enabled="{{defaultEnabled}}" {{#if enabled}}checked{{/if}} {{#unless ../../editable}}disabled{{/unless}}>
            <span>{{label}}</span>
            {{#unless toggleOnly}}
            <input type="number" name="scaling.{{key}}" min="0" max="100" step="0.001" value="{{value}}" data-default-value="{{defaultValue}}" aria-label="{{label}} scaling per level" {{#unless ../../editable}}disabled{{/unless}}>
            {{/unless}}
          </label>
          {{/each}}
        </div>
      </fieldset>
      {{/each}}
      </fieldset>
    </details>
    <button type="button" data-npc-config-reset-levels {{#unless editable}}disabled{{/unless}}>
      <i class="fas fa-rotate-left" aria-hidden="true"></i> Reset Level Settings
    </button>
  </section>
  <section class="npc-config-panel" data-npc-config-panel="relationships" hidden>
    <p class="hint">Relationship Rank is the average of these six statistics. A whole-number rank is added to the NPC's level; fractional ranks do not change the level.</p>
    <div class="npc-config-relationship-grid">
      {{#each relationshipFields}}
      <label class="form-group" data-tooltip="{{tooltip}}">
        <span class="npc-config-relationship-label" style="--npc-config-attribute-color: {{color}}">
          <i class="fa-solid fa-{{icon}}" aria-hidden="true"></i>{{label}}
        </span>
        <input type="number" name="relationshipStatistics.{{key}}" step="1" value="{{value}}" {{#unless ../editable}}disabled{{/unless}}>
      </label>
      {{/each}}
    </div>
    <p class="npc-config-relationship-rank">Relationship Rank: <output data-relationship-rank>{{relationshipRank}}</output> · Level bonus: <output data-relationship-level-adjustment>{{relationshipLevelAdjustment}}</output></p>
  </section>
  <section class="npc-config-panel" data-npc-config-panel="resources" hidden>
    <p class="hint">Leave a field blank to use the derived maximum. An optional Foundry Roll formula replaces that maximum. Results are rounded down; maximum-reduction effects still apply.</p>
    {{#each resources}}
    <label class="form-group npc-config-formula">
      <span>{{label}}</span>
      <input type="text" name="formulas.{{key}}" value="{{formula}}" placeholder="{{derivedFormula}}" {{#unless ../editable}}disabled{{/unless}}>
    </label>
    {{/each}}
  </section>
  <footer class="form-footer">
    <button type="submit" {{#unless editable}}disabled{{/unless}}><i class="fas fa-save"></i> Save Configuration</button>
  </footer>
</section>
